    <ClCompile Include="tests\test_check_report.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>

  <!-- Run unit tests after build, relying solely on the test exe's exit code
       (0 = all pass, 1 = failure). IgnoreStandardErrorWarningFormat=true stops MSBuild
       scanning the test's stdout/stderr for "error" lines: the tests deliberately emit
       "error : ..." diagnostics while exercising error paths, which would otherwise be
       misclassified as build errors (MSB3077) even when the suite returns 0. -->
  <!-- FcTestsStamp is durable proof that the suite really executed for THIS configuration:
       deleted before the run, written only after the exe returns 0. A green build without
       this file means the tests did not run (see ReportTestsSkipped). -->
  <Target Name="RunUnitTests" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(FcCanRunBuiltBinary)' == 'true'">
    <Message Text="Running FastCheck unit tests ($(Configuration)|$(Platform))..." Importance="high" />
    <Delete Files="$(TargetDir)$(ProjectName).testsran.txt" />
    <Exec Command='"$(TargetPath)"' IgnoreStandardErrorWarningFormat="true" />
    <Message Text="FastCheck unit tests PASSED ($(Configuration)|$(Platform))." Importance="high" />
    <WriteLinesToFile File="$(TargetDir)$(ProjectName).testsran.txt"
                      Lines="FastCheckTests: unit PASSED;Configuration=$(Configuration);Platform=$(Platform);HostArch=$(PROCESSOR_ARCHITECTURE);At=$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))"
                      Overwrite="true" WriteOnlyWhenDifferent="false" />
  </Target>

  <!-- Cross-compilation must never look like a passing test run: say so loudly. -->
  <Target Name="ReportTestsSkipped" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(FcCanRunBuiltBinary)' != 'true'">
    <Message Importance="high"
             Text="TESTS SKIPPED: a $(Platform) binary cannot execute on this $(PROCESSOR_ARCHITECTURE) host (cross-compilation). FastCheck unit tests did NOT run for $(Configuration)|$(Platform). Run on an ARM64 host, or pass -p:FCTestsRequired=true to turn this into an error." />
  </Target>

  <!-- Opt-in gate: -p:FCTestsRequired=true turns a skipped run into a hard error so CI (or a
       release build) can assert "the tests really ran" instead of trusting a green build. -->
  <Target Name="RequireTestsRan" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(FCTestsRequired)' == 'true' And '$(FcCanRunBuiltBinary)' != 'true'">
    <Error Text="FCTestsRequired=true, but tests cannot run: $(Platform) binaries cannot execute on this $(PROCESSOR_ARCHITECTURE) host." />
  </Target>
</Project>
