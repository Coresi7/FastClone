  <!-- Run unit tests after build, relying solely on the test exe's exit code
       (0 = all pass, 1 = failure). IgnoreStandardErrorWarningFormat=true stops MSBuild
       scanning the test's stdout/stderr for "error" lines: the tests deliberately emit
       "error : ..." diagnostics while exercising error paths, which would otherwise be
       misclassified as build errors (MSB3077) even when the suite returns 0. -->
  <Target Name="RunUnitTests" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Text="Running FastClone unit tests..." Importance="high" />
    <Exec Command='"$(TargetPath)"' IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Run data-integrity integration test (requires FastClone.exe built in the same
       configuration; the script auto-resolves the exe path). Covers the C2 byte-for-byte
       transfer guarantee that unit tests cannot reach (sync_engine_server.cpp is excluded
       from this project). Windows-only: uses PowerShell + Get-FileHash. -->
  <Target Name="RunDataIntegrityIntegration" AfterTargets="RunUnitTests" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Text="Running data-integrity integration test..." Importance="high" />
    <Exec Command='powershell -ExecutionPolicy Bypass -File "$(ProjectDir)..\tests\data_integrity_integration.ps1"'
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
