  <!-- /MP: compile multiple .cpp in parallel within this project (uses all logical CPUs).
       On HDD, if you see thrashing, cap it by switching this off and adding /MP4 to
       AdditionalOptions instead. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Dedicated intermediate dir so the shared .cpp objs never collide with FastClone's
       or FastCloneRouteProbe's IntDir (design §3.6 / R-05). -->
  <PropertyGroup>
    <IntDir>$(Platform)\$(Configuration)\FastCloneTests\</IntDir>
    <!-- Forward slashes so FASTCLONE_CLI_SRC is a valid C string literal (backslashes escape). -->
    <FastCloneCliSrc>$(ProjectDir)cli.cpp</FastCloneCliSrc>
    <FastCloneCliSrc>$(FastCloneCliSrc.Replace('\','/'))</FastCloneCliSrc>
  </PropertyGroup>

