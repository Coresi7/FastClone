  <!-- Windows on ARM64 (WoA): the two ARM64 configurations above inherit every setting from
       x64 (same v145 toolset, same warnings, same /GL + /LTCG Release) — see the
       Or '$(Platform)'=='ARM64' conditions on the ImportGroups / ItemDefinitionGroups below.
       Kept in lock-step with the sibling projects so the whole solution has one triplet. -->
  <PropertyGroup Condition="'$(Platform)'=='ARM64'">
    <VcpkgTriplet>arm64-windows</VcpkgTriplet>
  </PropertyGroup>

  <!-- /MP: compile multiple .cpp in parallel within this project (uses all logical CPUs).
       On HDD, if you see thrashing, cap it by switching this off and adding /MP4 to
       AdditionalOptions instead. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Dedicated intermediate dir so the shared .cpp objs never collide with FastClone's
