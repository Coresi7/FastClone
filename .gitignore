# Build directories (rule-based; no longer enumerate build_xxx one by one).
build*/
out/
_bl_*/
build_verify/

# Editor / IDE scratch.
.vs/
.idea/
.cursor/

# MSVC / VS product directories.
**/x64/
**/ARM64/
**/Win32/
**/Release/
**/Debug/

# Single-file build products (kept as a safety net).
*.obj
*.pdb
*.ilk
*.tlog
*.lastbuildstate
*.recipe
*.iobj
*.ipdb
*.idb
*.exe
# Log files: restricted to build output directories only (avoid swallowing
# legitimate repo-tracked logs such as docs/tasks/*/baseline.log, post.log,
# 07-security-scan.log). *.log under build*/ and out/ still ignored.
build*/*.log
out/*.log
*.user
*.suo
*.VC.db
*.VC.opendb
*.ipch

# Local temp / scratch.
tmp/
temp/
HARNESS_VERSION
dev-map.md

# Auto-version persistent counter (cmake-auto-version). Local state only; the version
# is reproducible on a clean checkout via git (rev-list --count), so this never ships.
.fcversion

# Documentation working area (user decision: docs/ stays ignored; stage
# artifacts live only in the local workspace and do not enter version control).
docs/
